# ── App ──────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_DEBUG=false
FRONTEND_URL=http://localhost:85

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/tickets.db

# ── On-Premise LDAP / LDAPS ──────────────────────
LDAP_ENABLED=true
LDAP_SERVER=ldaps://dc.escola.local
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BIND_DN=cn=svc_tickets,ou=ServiceAccounts,dc=escola,dc=local
LDAP_BIND_PASSWORD=service-account-password
LDAP_BASE_DN=ou=Staff,dc=escola,dc=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ADMIN_GROUP=CN=TI-Suporte,ou=Groups,dc=escola,dc=local

# ── Azure AD / Entra ID ──────────────────────────
AZURE_AD_ENABLED=true
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_REDIRECT_URI=http://localhost:8089/api/v1/auth/azure-callback
AZURE_ADMIN_GROUP_ID=

# ── JWT ──────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Email (SMTP) ─────────────────────────────────
MAIL_USERNAME=tickets@escola.local
MAIL_PASSWORD=smtp-password
MAIL_FROM=tickets@escola.local
MAIL_SERVER=smtp.escola.local
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_SUPPRESS_SEND=false
