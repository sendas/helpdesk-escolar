# ── Caddy / Domínio ──────────────────────────────
DOMAIN=helpdesk.queiro.pt
ACME_EMAIL=ti@queiro.pt

# ── App ──────────────────────────────────────────
APP_SECRET_KEY=GERA-UMA-CHAVE-COM: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_DEBUG=false
FRONTEND_URL=https://helpdesk.queiro.pt

# Se migrares do Unraid para cá e os dois estiverem ativos em simultâneo,
# adiciona aqui o URL do Unraid para o CORS não bloquear:
# EXTRA_ALLOWED_ORIGINS=http://192.168.1.50:85

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/tickets.db

# ── LDAP ─────────────────────────────────────────
LDAP_ENABLED=true
LDAP_SERVER=ldaps://dc.escola.local
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BIND_DN=cn=svc_tickets,ou=ServiceAccounts,dc=escola,dc=local
LDAP_BIND_PASSWORD=password-da-conta-servico
LDAP_BASE_DN=ou=Staff,dc=escola,dc=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ADMIN_GROUP=CN=TI-Suporte,ou=Groups,dc=escola,dc=local

# ── Azure AD ──────────────────────────────────────
AZURE_AD_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://helpdesk.queiro.pt/api/v1/auth/azure-callback
AZURE_ADMIN_GROUP_ID=

# ── JWT ──────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Email ─────────────────────────────────────────
MAIL_SERVER=smtp.queiro.pt
MAIL_PORT=587
MAIL_FROM=tickets@queiro.pt
MAIL_USERNAME=tickets@queiro.pt
MAIL_PASSWORD=password-do-email
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_SUPPRESS_SEND=false
