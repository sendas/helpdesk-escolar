# ── App ──────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_DEBUG=false
FRONTEND_URL=https://helpdesk.techpro.pt

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/tickets.db

# ── On-Premise LDAP / LDAPS ──────────────────────
LDAP_ENABLED=false
# Prefer the AD server IP on Unraid if Docker containers cannot resolve .local/.domain names.
LDAP_SERVER=ldaps://10.114.80.4
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BIND_DN=CN=svc_helpdesk,CN=Users,DC=queiroz,DC=local
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=queiroz,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ADMIN_GROUP=CN=Helpdesk-Tecnicos,CN=Users,DC=queiroz,DC=local

# ── Azure AD / Entra ID ──────────────────────────
AZURE_AD_ENABLED=true
AZURE_TENANT_ID=change-me-directory-tenant-id
AZURE_CLIENT_ID=change-me-application-client-id
AZURE_CLIENT_SECRET=change-me-client-secret-value
AZURE_REDIRECT_URI=https://helpdesk.techpro.pt/api/v1/auth/azure-callback
AZURE_ADMIN_GROUP_ID=
AZURE_ADMIN_EMAILS=
AZURE_ALLOWED_ONPREM_OUS=queiroz.local/AEEQ/_Direcao,queiroz.local/AEEQ/_Docentes,queiroz.local/AEEQ/_Nao Docentes,queiroz.local/AEEQ/_Secretaria,queiroz.local/AEEQ/_Suporte
AZURE_ADMIN_ONPREM_OUS=queiroz.local/AEEQ/_Direcao
AZURE_TECHNICIAN_ONPREM_OUS=queiroz.local/AEEQ/_Suporte
AZURE_SECRETARY_ONPREM_OUS=queiroz.local/AEEQ/_Secretaria
AZURE_NON_TEACHING_ONPREM_OUS=queiroz.local/AEEQ/_Nao Docentes
AZURE_SYNC_INTERVAL_MINUTES=60

# ── JWT ──────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Email (SMTP) ─────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=tickets@escola.local
MAIL_SERVER=
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_SUPPRESS_SEND=false
